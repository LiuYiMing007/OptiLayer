{
  "name": "tfc-for-mac",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "engine:test": "node scripts/run_python.mjs -m unittest discover -s engine/tests -v",
    "engine:bundle": "node scripts/run_python.mjs scripts/bundle_engine.py",
    "desktop:build": "npm run engine:bundle && node scripts/build_desktop.mjs && node scripts/run_python.mjs scripts/stage_release.py",
    "test": "npm run engine:test && node --experimental-strip-types --test tests/*.test.ts && node scripts/run_python.mjs -m unittest discover -s tests -p \"test_*.py\" -v",
    "validate:optics": "node scripts/run_python.mjs scripts/validate_engine.py",
    "sync": "node scripts/git_sync.mjs sync",
    "publish:version": "node scripts/git_sync.mjs release",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "tsc -b && vite build --config vite.mobile.config.ts",
    "mobile:preview": "vite preview --config vite.mobile.config.ts --host 0.0.0.0 --port 1421"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "plotly.js-basic-dist-min": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  },
  "tfcRevision": 1
}
